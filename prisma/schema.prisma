generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USUARIOS Y ROLES ────────────────────────────────────────────────────────

enum Rol {
  DUENO
  EMPLEADO
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rol          Rol      @default(EMPLEADO)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")

  operacionesFinancieras OperacionFinanciera[]
  sesionesXbox           SesionXbox[]
  servicios              Servicio[]
  ventasProductos        VentaProducto[]
  cierresDia             CierreDia[]
  aperturasFinanciero    AperturaFinanciero[]
  movimientosFinanciero  MovimientoFinanciero[]
  cierresFinanciero      CierreFinanciero[]
  gastos                 Gasto[]

  @@map("usuarios")
}

// ─── SERVICIO FINANCIERO ─────────────────────────────────────────────────────

model TipoOperacionFinanciera {
  id                 Int                   @id @default(autoincrement())
  nombre             String                @unique
  // comisión fija en pesos o porcentaje, según aplique
  comisionPorcentaje Decimal?              @map("comision_porcentaje") @db.Decimal(5, 2)
  comisionFija       Decimal?              @map("comision_fija") @db.Decimal(10, 2)
  activo             Boolean               @default(true)
  operaciones        OperacionFinanciera[]

  @@map("tipos_operacion_financiera")
}

enum MetodoPago {
  EFECTIVO
  TARJETA
}

model OperacionFinanciera {
  id         Int                     @id @default(autoincrement())
  tipoId     Int                     @map("tipo_id")
  tipo       TipoOperacionFinanciera @relation(fields: [tipoId], references: [id])
  monto      Decimal                 @db.Decimal(10, 2)
  comision   Decimal                 @db.Decimal(10, 2)
  metodoPago MetodoPago              @map("metodo_pago")
  notas      String?
  hora       DateTime                @default(now())
  empleadoId Int                     @map("empleado_id")
  empleado   Usuario                 @relation(fields: [empleadoId], references: [id])

  @@map("operaciones_financieras")
}

// ─── XBOX Y COBROS ────────────────────────────────────────────────────────────

model Consola {
  id       Int          @id @default(autoincrement())
  nombre   String
  numero   Int          @unique
  activa   Boolean      @default(true)
  sesiones SesionXbox[]

  @@map("consolas")
}

model SesionXbox {
  id               Int      @id @default(autoincrement())
  consolaId        Int      @map("consola_id")
  consola          Consola  @relation(fields: [consolaId], references: [id])
  inicio           DateTime
  fin              DateTime?
  duracionMinutos  Int?     @map("duracion_minutos")
  tiempoDefinidoMinutos Int? @map("tiempo_definido_minutos")
  controlesExtra   Int      @default(0) @map("controles_extra")
  // precio por control extra adicional al tiempo
  montoControles   Decimal  @default(0) @map("monto_controles") @db.Decimal(10, 2)
  montoTiempo      Decimal   @default(0) @map("monto_tiempo") @db.Decimal(10, 2)
  total            Decimal   @default(0) @db.Decimal(10, 2)
  metodoPago       MetodoPago @default(EFECTIVO) @map("metodo_pago")
  pausadoEn        DateTime? @map("pausado_en")
  empleadoId       Int      @map("empleado_id")
  empleado         Usuario  @relation(fields: [empleadoId], references: [id])

  @@map("sesiones_xbox")
}

// ─── SERVICIOS (impresiones, copias, escáner, CURP, RFC, etc.) ───────────────

model TipoServicio {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  precioBase  Decimal    @map("precio_base") @db.Decimal(10, 2)
  // true = precio es por unidad (ej. impresiones), false = precio fijo
  porUnidad   Boolean    @default(true) @map("por_unidad")
  activo      Boolean    @default(true)
  servicios   Servicio[]

  @@map("tipos_servicio")
}

model Servicio {
  id              Int          @id @default(autoincrement())
  tipoId          Int          @map("tipo_id")
  tipo            TipoServicio @relation(fields: [tipoId], references: [id])
  cantidad        Int          @default(1)
  precioUnitario  Decimal      @map("precio_unitario") @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  metodoPago      MetodoPago   @default(EFECTIVO) @map("metodo_pago")
  notas           String?
  hora            DateTime     @default(now())
  empleadoId      Int          @map("empleado_id")
  empleado        Usuario      @relation(fields: [empleadoId], references: [id])

  @@map("servicios")
}

// ─── PRODUCTOS E INVENTARIO ───────────────────────────────────────────────────

enum CategoriaProducto {
  DULCES
  FRITURAS
  PAPELERIA
  BEBIDAS
  OTRO
}

model CategoriaProductoConfig {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  activa   Boolean   @default(true)

  @@map("categorias_producto_config")
}

model Producto {
  id              Int               @id @default(autoincrement())
  nombre          String
  categoria       CategoriaProducto @default(OTRO)
  categoriaExtra  String?           @map("categoria_extra")
  precioVenta     Decimal           @map("precio_venta") @db.Decimal(10, 2)
  precioCosto     Decimal           @map("precio_costo") @db.Decimal(10, 2)
  stockActual     Int               @default(0) @map("stock_actual")
  stockMinimo     Int               @default(5) @map("stock_minimo")
  activo          Boolean           @default(true)
  creadoEn        DateTime          @default(now()) @map("creado_en")
  ventas          VentaProducto[]

  @@map("productos")
}

model VentaProducto {
  id             Int        @id @default(autoincrement())
  productoId     Int        @map("producto_id")
  producto       Producto   @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal    @map("precio_unitario") @db.Decimal(10, 2)
  total          Decimal    @db.Decimal(10, 2)
  metodoPago     MetodoPago @default(EFECTIVO) @map("metodo_pago")
  hora           DateTime   @default(now())
  empleadoId     Int        @map("empleado_id")
  empleado       Usuario    @relation(fields: [empleadoId], references: [id])

  @@map("ventas_productos")
}

// ─── CIERRE DEL DÍA ──────────────────────────────────────────────────────────

model CierreDia {
  id                   Int      @id @default(autoincrement())
  fecha                DateTime @unique @db.Date
  totalXbox            Decimal  @map("total_xbox") @db.Decimal(10, 2)
  totalServicios       Decimal  @map("total_servicios") @db.Decimal(10, 2)
  totalFinanciero      Decimal  @map("total_financiero") @db.Decimal(10, 2)
  totalProductos       Decimal  @map("total_productos") @db.Decimal(10, 2)
  totalComisiones      Decimal  @map("total_comisiones") @db.Decimal(10, 2)
  // suma de todos los ingresos del día
  totalGeneral         Decimal  @map("total_general") @db.Decimal(10, 2)
  // cuánto efectivo debería haber en caja
  efectivoEsperado     Decimal  @map("efectivo_esperado") @db.Decimal(10, 2)
  // cuánto efectivo contó el empleado al cerrar
  efectivoReal         Decimal  @map("efectivo_real") @db.Decimal(10, 2)
  diferencia           Decimal  @db.Decimal(10, 2)
  notas                String?
  empleadoId           Int      @map("empleado_id")
  empleado             Usuario  @relation(fields: [empleadoId], references: [id])
  creadoEn             DateTime @default(now()) @map("creado_en")

  @@map("cierres_dia")
}

// ─── CONFIGURACIÓN DEL SISTEMA ────────────────────────────────────────────────

model ConfiguracionXbox {
  id                    Int     @id @default(autoincrement())
  precioPorHora         Decimal @map("precio_por_hora") @db.Decimal(10, 2)
  precioPorMediaHora    Decimal @map("precio_por_media_hora") @db.Decimal(10, 2)
  precioPorMinuto       Decimal @map("precio_por_minuto") @db.Decimal(10, 2)
  precioControlExtra    Decimal @map("precio_control_extra") @db.Decimal(10, 2)

  @@map("configuracion_xbox")
}

model CategoriaGasto {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique
  esDefault Boolean @default(false) @map("es_default")
  activa    Boolean @default(true)
  gastos    Gasto[]

  @@map("categorias_gasto")
}

model Gasto {
  id          Int             @id @default(autoincrement())
  categoriaId Int?            @map("categoria_id")
  categoria   CategoriaGasto? @relation(fields: [categoriaId], references: [id])
  descripcion String
  monto       Decimal         @db.Decimal(10, 2)
  fecha       DateTime        @db.Date
  creadoEn    DateTime        @default(now()) @map("creado_en")
  empleadoId  Int             @map("empleado_id")
  empleado    Usuario         @relation(fields: [empleadoId], references: [id])

  @@map("gastos")
}

// ─── MÓDULO FINANCIERO ────────────────────────────────────────────────────────

enum TipoMovimiento {
  RETIRO
  DEPOSITO
}

enum EstadoMovimiento {
  PENDIENTE   // retiro recibido, cliente aún no recoge el efectivo
  COMPLETADO  // operación finalizada
  CANCELADO   // operación anulada
}

enum TipoComision {
  EFECTIVO      // cliente pagó/dio la comisión aparte en efectivo
  TRANSFERENCIA // retiro: cliente transfirió monto+comisión, comisión queda en tarjeta
  DESCONTADA    // depósito: se descuenta del monto transferido al cliente
}

model ConfigFinanciero {
  id           Int     @id @default(1)
  capitalTotal Decimal @map("capital_total") @db.Decimal(14, 2)

  @@map("config_financiero")
}

model AperturaFinanciero {
  id                  Int      @id @default(autoincrement())
  fecha               DateTime @unique @db.Date
  // efectivo que Guadalupe saca de la caja azul para darle a la empleada
  efectivoEmpleada    Decimal  @map("efectivo_empleada") @db.Decimal(12, 2)
  // saldo de la tarjeta al inicio del día (lo registra Guadalupe)
  saldoTarjetaInicial Decimal  @map("saldo_tarjeta_inicial") @db.Decimal(12, 2)
  empleadoId          Int      @map("empleado_id")
  empleado            Usuario  @relation(fields: [empleadoId], references: [id])
  creadoEn            DateTime @default(now()) @map("creado_en")

  @@map("aperturas_financiero")
}

model MovimientoFinanciero {
  id            Int            @id @default(autoincrement())
  tipo          TipoMovimiento
  estado        EstadoMovimiento @default(COMPLETADO)
  tipoComision  TipoComision     @default(EFECTIVO) @map("tipo_comision")
  monto         Decimal          @db.Decimal(12, 2)
  comision      Decimal          @db.Decimal(10, 2)
  notas         String?
  hora          DateTime         @default(now())
  confirmadoEn  DateTime?        @map("confirmado_en")
  empleadoId    Int            @map("empleado_id")
  empleado      Usuario        @relation(fields: [empleadoId], references: [id])

  @@map("movimientos_financiero")
}

model CierreFinanciero {
  id                   Int      @id @default(autoincrement())
  fecha                DateTime @unique @db.Date
  efectivoFinal        Decimal  @map("efectivo_final") @db.Decimal(12, 2)
  sobrante             Decimal  @db.Decimal(12, 2)
  cajaChicaCalculada   Decimal  @default(0) @map("caja_chica_calculada") @db.Decimal(12, 2)
  cajaChicaReal        Decimal  @default(0) @map("caja_chica_real") @db.Decimal(12, 2)
  diferenciaCajaChica  Decimal  @default(0) @map("diferencia_caja_chica") @db.Decimal(12, 2)
  saldoTarjetaEsperado Decimal  @map("saldo_tarjeta_esperado") @db.Decimal(12, 2)
  saldoTarjetaReal     Decimal  @map("saldo_tarjeta_real") @db.Decimal(12, 2)
  diferencia           Decimal  @db.Decimal(12, 2)
  empleadoId           Int      @map("empleado_id")
  empleado             Usuario  @relation(fields: [empleadoId], references: [id])
  creadoEn             DateTime @default(now()) @map("creado_en")

  @@map("cierres_financiero")
}
