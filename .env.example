# PostgreSQL — Railway provee esta variable automáticamente al conectar el plugin
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Hashes bcrypt de los PINs de acceso
# Genera con: node -e "require('bcryptjs').hash('TU_PIN', 12).then(console.log)"
PIN_DUENO_HASH=$2b$12$...
PIN_EMPLEADO_HASH=$2b$12$...

# Secreto para cifrar la cookie de sesión — mínimo 32 caracteres
# Genera uno con: openssl rand -base64 32
SESSION_PASSWORD="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
